# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_PROJECT_ID].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGci..."

# Service role key — used server-side to invoke the ai-tagging Edge Function
SUPABASE_SERVICE_ROLE_KEY="eyJhbGci..."

# YouTube Data API v3 — optional; enriches bookmarks with channel, duration,
# description, tags, and category. Without it only oEmbed title/thumbnail is saved.
YOUTUBE_API_KEY="AIza..."

# Google Cloud Translation API — optional; stores English translations of tags
# so search works across languages.
GOOGLE_TRANSLATE_API_KEY="AIza..."

# OpenRouter — used for on-demand video summaries (Gemini).
OPENROUTER_API_KEY="sk-or-v1-..."

# NOTE: The ai-tagging Edge Function reads OPENROUTER_API_KEY and
# GOOGLE_TRANSLATE_API_KEY from Supabase secrets, not from this file:
#   supabase secrets set OPENROUTER_API_KEY=... GOOGLE_TRANSLATE_API_KEY=...
